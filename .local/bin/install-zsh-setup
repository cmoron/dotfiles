#!/usr/bin/env bash
# install-zsh-setup — bootstrap la conf zsh des dotfiles.
# Idempotent : peut être relancé sans casser ce qui est déjà en place.
#
# Étapes :
#   1. install des outils CLI (apt + scripts officiels starship/atuin)
#   2. clone des plugins zsh (syntax-highlighting, autosuggestions)
#   3. symlinks .profile, .zshenv, .zprofile, .zshrc, .config/{starship,atuin}
#   4. activation du shell : ajout à /etc/shells + chsh (opt-in, demande confirm)

set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/src/dotfiles}"
[[ ! -d "$DOTFILES" ]] && { echo "❌ DOTFILES introuvable : $DOTFILES"; exit 1; }

say()  { printf '\033[1;36m▶\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m✓\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*"; }

# ── 1. install des outils CLI ───────────────────────────────────────────
say "Vérif/install des outils CLI"
if command -v apt-get >/dev/null; then
    pkgs=(zsh fzf eza)
    to_install=()
    for p in "${pkgs[@]}"; do
        dpkg -s "$p" &>/dev/null || to_install+=("$p")
    done
    if (( ${#to_install[@]} > 0 )); then
        say "sudo apt-get install ${to_install[*]}"
        sudo apt-get update -qq && sudo apt-get install -y "${to_install[@]}"
    else
        ok "paquets apt déjà installés"
    fi
else
    warn "apt-get introuvable — installe manuellement : zsh fzf eza"
fi

# starship & atuin : pas toujours packagés → scripts d'install officiels
if ! command -v starship >/dev/null; then
    say "install starship"
    curl -sS https://starship.rs/install.sh | sh -s -- -y
else
    ok "starship déjà installé"
fi
if ! command -v atuin >/dev/null; then
    say "install atuin"
    curl -fsSL https://setup.atuin.sh | sh
else
    ok "atuin déjà installé"
fi

# ── 2. plugins zsh ──────────────────────────────────────────────────────
ZSH_PLUGINS="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins"
say "Vérif/clone des plugins zsh dans $ZSH_PLUGINS"
mkdir -p "$ZSH_PLUGINS"
clone_plugin() {
    local dst="$ZSH_PLUGINS/${1##*/}"
    if [[ -d "$dst" ]]; then
        ok "${1##*/} déjà cloné"
    else
        git clone --depth=1 -q "https://github.com/$1" "$dst"
        ok "${1##*/} cloné"
    fi
}
clone_plugin zsh-users/zsh-syntax-highlighting
clone_plugin zsh-users/zsh-autosuggestions

# ── 3. symlinks ─────────────────────────────────────────────────────────
say "Symlinks dotfiles → \$HOME"

link() {
    local src="$1" dst="$2"
    if [[ -L "$dst" ]]; then
        local current
        current=$(readlink "$dst")
        if [[ "$current" == "$src" ]]; then
            ok "$dst → $src (déjà OK)"
            return 0
        fi
        warn "$dst pointe vers $current — overwriting"
        rm "$dst"
    elif [[ -e "$dst" ]]; then
        warn "$dst existe et n'est pas un symlink — backup vers $dst.bak"
        mv "$dst" "$dst.bak"
    fi
    ln -s "$src" "$dst"
    ok "$dst → $src"
}

mkdir -p "$HOME/.config/atuin"
# .profile : env POSIX partagé — .zshenv le source pour TOUS les zsh.
link "$DOTFILES/.profile"                "$HOME/.profile"
link "$DOTFILES/.zshenv"                 "$HOME/.zshenv"
link "$DOTFILES/.zprofile"               "$HOME/.zprofile"
link "$DOTFILES/.zshrc"                  "$HOME/.zshrc"
link "$DOTFILES/.config/starship.toml"   "$HOME/.config/starship.toml"
link "$DOTFILES/.config/atuin/config.toml" "$HOME/.config/atuin/config.toml"

# ── 4. activation du shell (opt-in) ─────────────────────────────────────
ZSH_BIN="$(command -v zsh)"
say "Shell par défaut actuel : $SHELL"
if [[ "$SHELL" == "$ZSH_BIN" ]] || [[ "$SHELL" == "/bin/zsh" && "$ZSH_BIN" == "/bin/zsh" ]]; then
    ok "zsh est déjà le shell par défaut"
else
    echo
    read -r -p "Activer zsh comme shell par défaut ? [y/N] " ans
    if [[ "$ans" =~ ^[Yy]$ ]]; then
        if ! grep -qx "$ZSH_BIN" /etc/shells; then
            say "Ajout de $ZSH_BIN à /etc/shells (sudo requis)"
            echo "$ZSH_BIN" | sudo tee -a /etc/shells >/dev/null
        fi
        chsh -s "$ZSH_BIN"
        ok "shell par défaut = $ZSH_BIN (effectif au prochain login)"
    else
        ok "zsh non activé (tu peux le tester avec 'zsh' depuis bash)"
    fi
fi

echo
ok "Setup terminé. Lance 'zsh' pour tester."
echo
echo "  Astuces :"
echo "    - première commande : 'atuin import auto' pour migrer ton history bash"
echo "    - polices : pour les icônes starship, install une Nerd Font :"
echo "        sudo apt-get install fonts-hack  (ou télécharge une Nerd Font)"
