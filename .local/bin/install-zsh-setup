#!/usr/bin/env bash
# Deploy configuration links; install tools separately (see README.md).
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/src/dotfiles}"
[[ -f "$DOTFILES/.zshrc" ]] || { echo "Dotfiles introuvables : $DOTFILES" >&2; exit 1; }
DOTFILES=$(cd "$DOTFILES" && pwd)

link() {
    local src="$1" dst="$2" backup count=0
    [[ -e "$src" ]] || { echo "Source introuvable : $src" >&2; exit 1; }
    if [[ -L "$dst" && "$(readlink "$dst")" == "$src" ]]; then
        return 0
    fi
    if [[ -e "$dst" || -L "$dst" ]]; then
        backup="$dst.bak"
        while [[ -e "$backup" || -L "$backup" ]]; do
            count=$((count + 1))
            backup="$dst.bak.$count"
        done
        mv "$dst" "$backup"
        printf 'Sauvegarde : %s\n' "$backup"
    fi
    mkdir -p "$(dirname "$dst")"
    ln -s "$src" "$dst"
}

for file in .profile .bash_profile .bashrc .zshenv .zprofile .zshrc .tmux.conf; do
    link "$DOTFILES/$file" "$HOME/$file"
done
for file in starship.toml atuin/config.toml eza/theme.yml; do
    link "$DOTFILES/.config/$file" "$HOME/.config/$file"
done
if [[ "$(uname -s)" == Darwin ]]; then
    link "$DOTFILES/.config/rio/config.toml" "$HOME/.config/rio/config.toml"
    link "$DOTFILES/.config/rio/themes/gruvbox-dark.toml" "$HOME/.config/rio/themes/gruvbox-dark.toml"
fi
printf 'Configuration déployée. Prérequis et activation de Zsh : README.md\n'
