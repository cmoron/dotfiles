#!/usr/bin/env bash
# install-zsh-setup — bootstrap la conf zsh des dotfiles.
# Idempotent : peut être relancé sans casser ce qui est déjà en place.
#
# Étapes :
#   1. brew install des outils (starship, atuin, zoxide, eza, bat, direnv, tldr)
#   2. clone de zinit dans ~/.local/share/zinit/zinit.git (si absent)
#   3. symlinks .zshenv, .zprofile, .zshrc et .config/{starship.toml,atuin/}
#   4. activation du shell : ajout à /etc/shells + chsh (opt-in, demande confirm)

set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/conf/dotfiles}"
[[ ! -d "$DOTFILES" ]] && { echo "❌ DOTFILES introuvable : $DOTFILES"; exit 1; }

say()  { printf '\033[1;36m▶\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m✓\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*"; }

# ── 1. brew install ────────────────────────────────────────────────────
say "Vérif/install des outils Homebrew"
if ! command -v brew >/dev/null; then
    warn "brew non installé — skip (vois https://brew.sh)"
else
    formulas=(starship atuin zoxide eza bat direnv tldr fzf)
    to_install=()
    for f in "${formulas[@]}"; do
        brew list --formula "$f" &>/dev/null || to_install+=("$f")
    done
    if (( ${#to_install[@]} > 0 )); then
        say "brew install ${to_install[*]}"
        brew install "${to_install[@]}"
    else
        ok "tous les formulas déjà installés"
    fi
fi

# ── 2. zinit ────────────────────────────────────────────────────────────
ZINIT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"
say "Vérif/clone de zinit dans $ZINIT_HOME"
if [[ -d "$ZINIT_HOME" ]]; then
    ok "zinit déjà cloné"
else
    mkdir -p "$(dirname "$ZINIT_HOME")"
    git clone --depth=1 https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
    ok "zinit cloné"
fi

# ── 3. symlinks ─────────────────────────────────────────────────────────
say "Symlinks dotfiles → \$HOME"

link() {
    local src="$1" dst="$2"
    if [[ -L "$dst" ]]; then
        local current
        current=$(readlink "$dst")
        if [[ "$current" == "$src" ]]; then
            ok "$dst → $src (déjà OK)"
            return 0
        fi
        warn "$dst pointe vers $current — overwriting"
        rm "$dst"
    elif [[ -e "$dst" ]]; then
        warn "$dst existe et n'est pas un symlink — backup vers $dst.bak"
        mv "$dst" "$dst.bak"
    fi
    ln -s "$src" "$dst"
    ok "$dst → $src"
}

mkdir -p "$HOME/.config/atuin"
link "$DOTFILES/.zshenv"                 "$HOME/.zshenv"
link "$DOTFILES/.zprofile"               "$HOME/.zprofile"
link "$DOTFILES/.zshrc"                  "$HOME/.zshrc"
link "$DOTFILES/.config/starship.toml"   "$HOME/.config/starship.toml"
link "$DOTFILES/.config/atuin/config.toml" "$HOME/.config/atuin/config.toml"

# Ghostty (si présent) : force le shell zsh côté terminal aussi
if [[ -d /Applications/Ghostty.app ]] || command -v ghostty &>/dev/null; then
    link "$DOTFILES/.config/ghostty"     "$HOME/.config/ghostty"
fi

# ── 4. activation du shell (opt-in) ─────────────────────────────────────
ZSH_BIN="$(command -v zsh)"
say "Shell par défaut actuel : $SHELL"
if [[ "$SHELL" == "$ZSH_BIN" ]] || [[ "$SHELL" == "/bin/zsh" && "$ZSH_BIN" == "/bin/zsh" ]]; then
    ok "zsh est déjà le shell par défaut"
else
    echo
    read -r -p "Activer zsh comme shell par défaut ? [y/N] " ans
    if [[ "$ans" =~ ^[Yy]$ ]]; then
        if ! grep -qx "$ZSH_BIN" /etc/shells; then
            say "Ajout de $ZSH_BIN à /etc/shells (sudo requis)"
            echo "$ZSH_BIN" | sudo tee -a /etc/shells >/dev/null
        fi
        chsh -s "$ZSH_BIN"
        ok "shell par défaut = $ZSH_BIN (effectif au prochain login)"
    else
        ok "zsh non activé (tu peux le tester avec 'zsh' depuis bash)"
    fi
fi

echo
ok "Setup terminé. Lance 'zsh' pour tester."
echo
echo "  Astuces :"
echo "    - première commande : 'atuin import auto' pour migrer ton history bash"
echo "    - greeting du jour : viens le déclencher avec 'rm ~/.cache/zsh-last-greet && zsh'"
echo "    - tips : tape 'tip' dans atuin search pour retrouver les hints"
echo "    - polices : pour les icônes eza/starship, install une Nerd Font :"
echo "        brew install --cask font-hack-nerd-font"
