# Ghostty — single source of truth.
# Symlinkée depuis ~/Library/Application Support/com.mitchellh.ghostty/
# (config + config.ghostty), qui est le chemin réellement lu par Ghostty sur macOS.
# Doc complète : ghostty +show-config --default | less

# ── Apparence ──
font-family = Hack Nerd Font
font-size = 14
background = #333

# Option agit comme Alt (Option+. → insert last arg, etc.)
macos-option-as-alt = left

# ── Shell ──
# Force zsh login shell. Sans ça, Ghostty hérite du $SHELL de la session
# GUI macOS, qui peut être obsolète tant que la session n'a pas été
# rejouée après chsh.
command = /bin/zsh --login

# ── Shell integration ──
# On retire `cursor` des features pour empêcher le shell de forcer une barre.
# Le block est par ailleurs forcé côté zsh (precmd hook DECSCUSR \e[2 q).
shell-integration = detect
shell-integration-features = no-cursor,no-sudo,title

# ── Curseur ──
cursor-style = block

# ── Confort ──
copy-on-select = clipboard
mouse-hide-while-typing = true
window-padding-x = 8
window-padding-y = 8

# --- Panes tmux ---
# Ctrl-Space est le préfixe tmux (NUL, \x00) ; Ghostty ne gère plus les splits.
keybind = super+h=text:\x00h
keybind = super+j=text:\x00j
keybind = super+k=text:\x00k
keybind = super+l=text:\x00l
keybind = super+d=text:\x00d
keybind = super+shift+d=text:\x00D
keybind = super+w=text:\x00x
keybind = super+ctrl+arrow_left=text:\x00H
keybind = super+ctrl+arrow_down=text:\x00J
keybind = super+ctrl+arrow_up=text:\x00K
keybind = super+ctrl+arrow_right=text:\x00L
